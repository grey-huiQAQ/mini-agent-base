# 复制本文件为 .env 并填入真实值：
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env

# 魔搭 API Token，获取地址：https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=ms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 可选：API 地址（默认如下）
MODELSCOPE_API_BASE_URL=https://api-inference.modelscope.cn/v1/

# 可选：模型名称（默认如下）
MODELSCOPE_MODEL_NAME=Qwen/Qwen3.5-35B-A3B
